{
  "name": "lick-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "bash scripts/deploy.sh",
    "analyze": "ANALYZE=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dump-prompts": "tsx evals/dump_prompts.ts > evals/prompts.json",
    "test": "vitest run --exclude \"qa/**\"",
    "test:watch": "vitest --exclude \"qa/**\"",
    "qa": "node --import tsx qa/run.mjs fixture",
    "qa:negative": "node --import tsx qa/run.mjs negative",
    "qa:live": "node --import tsx qa/run.mjs live"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@tailwindcss/vite": "^4.3.3",
    "abcjs": "^6.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tone": "^15.1.22",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.16",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "rollup-plugin-visualizer": "^6.0.11",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.8",
    "@playwright/test": "^1.63.0"
  }
}
